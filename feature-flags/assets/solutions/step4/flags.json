{
    "$schema": "https://flagd.dev/schema/v0/flags.json",
    "flags": {
        "dark-mode": {
            "state": "ENABLED",
            "variants": {
                "on": true,
                "off": false
            },
            "defaultVariant": "on"
        },
        "dashboard": {
            "state": "ENABLED",
            "variants": {
                "on": true,
                "off": false
            },
            "defaultVariant": "off",
            "targeting": {
                "if": [
                    { "ends_with": [{ "var": "email" }, "@company.com"] },
                    "on",
                    "off"
                ]
            }
        }
    }
}